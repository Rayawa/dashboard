{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/ability/entry.ets",
        "description": "$string:EntryAbility_desc",
//        "icon": "$media:layered_image",
//        "label": "$string:app_name",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "continuable": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["ohos.want.action.home"]
          },
          {
            "entities": ["top.rayawa.dashboard"],
            "actions": ["ohos.want.action.view"]
          }
        ]
      },
      {
        "name": "submitEntryAbility",
        "srcEntry": "./ets/ability/submitEntry.ets",
        "description": "$string:shareEntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:shareEntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background"
      },
      {
        "name": "queryEntryAbility",
        "srcEntry": "./ets/ability/queryEntry.ets",
        "description": "$string:queryEntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:queryEntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true
      }
    ],
    "extensionAbilities": [
      {
        "name": "query_ability",
        "srcEntry": "./ets/ability/query.ets",
        "description": "查看应用数据",
        "label": "$string:query_label",
        "type": "share",
        "exported": true,
        "skills": [
          {
            "actions": [
              "ohos.want.action.sendData"
            ],
            "uris": [
              {
                "scheme": "file",
                "utd": "general.hyperlink",
                "maxFileSupported": 1
              }
            ]
          }
        ]
      },
      {
        "name": "simple_share_ability",
        "srcEntry": "./ets/ability/simpleSubmit.ets",
        "description": "简单投稿页面",
        "label": "$string:simple_share_label",
        "type": "share",
        "exported": true,
        "skills": [
          {
            "actions": [
              "ohos.want.action.sendData"
            ],
            "uris": [
              {
                "scheme": "file",
                "utd": "general.hyperlink",
                "maxFileSupported": 1
              }
            ]
          }
        ]
      },
      {
        "name": "complex_share_ability",
        "srcEntry": "./ets/ability/complexSubmit.ets",
        "description": "复杂投稿页面",
        "label": "$string:complex_share_label",
        "type": "share",
        "exported": true,
        "skills": [
          {
            "actions": [
              "ohos.want.action.sendData"
            ],
            "uris": [
              {
                "scheme": "file",
                "utd": "general.hyperlink",
                "maxFileSupported": 1
              }
            ]
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.DETECT_GESTURE",
        "reason": "$string:GENSTURE_distributed_permission_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.VIBRATE",
        "reason": "$string:vibrate_permission_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility","shareEntryAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.DISTRIBUTED_DATASYNC",
        "reason": "$string:STORAGE_distributed_permission_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility","shareEntryAbility"
          ],
          "when": "always"
        }
      }
    ]
  }
}